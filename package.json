{
  "name": "prospere",
  "version": "0.1.0",
  "private": true,
  "description": "PROSPERE — sua trilha do zero ao próximo nível",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @prospere/web dev",
    "build": "pnpm --filter @prospere/web build",
    "start": "pnpm --filter @prospere/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @prospere/web db:generate",
    "db:push": "pnpm --filter @prospere/web db:push",
    "test:e2e": "playwright test",
    "db:studio": "pnpm --filter @prospere/web exec drizzle-kit studio",
    "email:testar": "node --env-file=.env scripts/testar-email.mjs",
    "email:dns": "node scripts/checar-dns-email.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
