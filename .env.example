# ---------- Banco ----------
DATABASE_URL="postgresql://prospere:prospere@localhost:5432/prospere"

# ---------- Auth ----------
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# ---------- E-mail: Resend (ADR-009) ----------
# "resend" envia de verdade; "console" escreve no log do servidor (dev e testes).
# Vazio = resend quando houver EMAIL_API_KEY, senão console.
EMAIL_TRANSPORT=""
# Chave em https://resend.com/api-keys (permissão de envio basta).
EMAIL_API_KEY=""
# Domínio do produto na Resend: prospere.vsatecnologia.com.br (precisa estar verificado).
# Enquanto a verificação não passa, use "PROSPERE <onboarding@resend.dev>" — remetente de
# teste da Resend, que entrega apenas para o e-mail dono da conta.
EMAIL_FROM="PROSPERE <nao-responda@prospere.vsatecnologia.com.br>"

# ---------- App ----------
# Em produção: https://prospere.vsatecnologia.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------- Lembretes (cron externo chamando POST /api/cron/lembretes) ----------
CRON_SECRET=""                 # openssl rand -base64 32

# Teste de envio: node --env-file=.env scripts/testar-email.mjs voce@exemplo.com

# ---------- Testes e2e ----------
# Caminho do Chromium quando o ambiente já traz o navegador instalado.
PLAYWRIGHT_CHROMIUM_PATH=""

# ---------- IA: rascunhos de campo (ADR-010) ----------
# Sem chave, os botões de rascunho não aparecem e o app funciona normalmente.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
